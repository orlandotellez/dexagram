---
import '../styles/themes.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Diagram Web — editor de diagramas ER',
  description = 'Editor visual de diagramas entidad-relación: organizá proyectos, creá diagramas y exportalos como HTML.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      /* Apply saved theme before first paint to prevent flash */
      (function () {
        try {
          var t = localStorage.getItem('diagram-web:theme');
          if (t) document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
